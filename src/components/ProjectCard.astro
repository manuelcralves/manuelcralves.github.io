---
/*
  ProjectCard: one project in the "Selected work" list on the home page.
  Skeleton for Manuel to complete. Follow the three TODOs below and compare
  with option A in C:\Users\manue\dev\portfolio-design-directions.html.
*/
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'projects'>;
	/** Position in the list, starting at 0. Shown as 01, 02, ... */
	index: number;
}

const { project, index } = Astro.props;
const { title, summary, kind, period, stack, highlight } = project.data;
const href = `/projects/${project.id}/`;
const number = String(index + 1).padStart(2, '0');
---

<article class="card">
	<span class="number" aria-hidden="true">{number}</span>
	<div class="body">
		<h3><a href={href}>{title}</a></h3>
		<p class="summary">{summary}</p>
		<p class="meta">{kind} · {period} · {stack.slice(0, 3).join(', ')}</p>
	</div>
	{
		highlight && (
			<div class="stat">
				<strong>{highlight.value}</strong>
				<span>{highlight.label}</span>
			</div>
		)
	}
</article>

<style>
	/* Three columns: number, text, highlight. */
	.card {
		position: relative;
		display: grid;
		grid-template-columns: 2.75rem 1fr auto;
		gap: var(--space-l);
		padding-block: var(--space-l);
		border-bottom: 1px solid var(--line);
	}

	.number {
		padding-top: 0.2em;
		color: var(--accent);
		font-family: var(--font-serif);
		font-size: 1.25rem;
		line-height: 1;
	}

	h3 {
		margin-bottom: var(--space-2xs);
		font-size: var(--step-2);
	}

	h3 a {
		text-decoration: none;
	}

	/* Stretch the title link over the whole card, so any click on it opens the project. */
	h3 a::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.card:hover h3 a {
		color: var(--accent);
	}

	.summary {
		color: var(--ink-soft);
	}

	.meta {
		margin-top: var(--space-xs);
		color: var(--muted);
		font-size: var(--step--1);
	}

	.stat {
		max-width: 10rem;
		text-align: right;
	}

	.stat strong {
		display: block;
		color: var(--accent);
		font-family: var(--font-serif);
		font-size: 2rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		line-height: 1;
	}

	.stat span {
		display: block;
		margin-top: var(--space-2xs);
		color: var(--muted);
		font-size: 0.8125rem;
		line-height: 1.35;
		text-wrap: balance;
	}

	/* Phones: the highlight moves under the text. */
	@media (max-width: 40rem) {
		.card {
			grid-template-columns: 2rem 1fr;
			gap: var(--space-s) var(--space-m);
		}

		.stat {
			grid-column: 2;
			max-width: none;
			text-align: left;
		}
	}
</style>
