---
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	/** Keeps the page out of search results, and gives it no canonical URL. */
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const year = new Date().getFullYear();

// Absolute URLs, because social networks and search engines need them.
const canonical = new URL(Astro.url.pathname, Astro.site);
const preview = new URL('/og.jpg', Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Manuel Alves" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{!noindex && <meta property="og:url" content={canonical} />}
		<meta property="og:image" content={preview} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Manuel Alves, software engineer working on applied AI" />
		<meta name="twitter:card" content="summary_large_image" />
		<Font cssVariable="--font-serif" preload />
		<Font cssVariable="--font-sans" preload />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<header class="site-header container">
			<a class="site-name" href="/">Manuel Alves</a>
			<nav aria-label="Main">
				<ul>
					<li><a href="/#work">Work</a></li>
					<li><a href="mailto:manuelcralves@gmail.com">Contact</a></li>
				</ul>
			</nav>
		</header>
		<main id="main" class="container">
			<slot />
		</main>
		<footer class="container">
			<div class="site-footer">
				<p>© {year} Manuel Alves · Built with Astro</p>
			</div>
		</footer>
	</body>
</html>

<style>
	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-m);
		padding-block: var(--space-l);
	}

	.site-name {
		font-family: var(--font-serif);
		font-size: 1.125rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		text-decoration: none;
	}

	nav ul {
		display: flex;
		gap: var(--space-2xs);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Padding keeps each link a comfortable tap target on phones. */
	nav a {
		display: inline-block;
		padding: var(--space-xs) var(--space-s);
		color: var(--muted);
		font-size: var(--step--1);
		text-decoration: none;
	}

	nav a:hover {
		color: var(--ink);
	}

	.site-footer {
		margin-top: var(--space-3xl);
		padding-block: var(--space-xl);
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: var(--step--1);
	}
</style>
